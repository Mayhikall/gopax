# Gopax Backend — Environment Variables
# Copy to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gopax

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# SIWE (Sign-In with Ethereum)
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=trip-proofs

# Blockchain (BSC Testnet by default)
RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
GOPAX_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
REWARD_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Isi dengan nilai PRIVATE_KEY yang sama dari contracts/.env
REWARD_SIGNER_PRIVATE_KEY=0x_PRIVATE_KEY_WALLET_DEPLOYER

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=minimax/minimax-m3:free

# CORS
CORS_ORIGIN=http://localhost:3000

# Distance providers: use an authorized Nominatim-compatible endpoint.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Identify your application; replace with real contact details if required by provider.
NOMINATIM_USER_AGENT=Gopax/1.0
OSRM_BASE_URL=https://router.project-osrm.org

# Photon demo: low-volume testing; no uptime guarantee.
GEOCODING_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io

# Set false only if Node fetch fails while curl succeeds on the same network.
NETWORK_AUTO_SELECT_FAMILY=true
