# Deployment Environment Variables for BSC Testnet (BNB Testnet)

# Private key dompet deployer (Wajib punya saldo tBNB untuk gas fee)
PRIVATE_KEY=your_private_key_here

# Address signer backend yang mengotorisasi claim via EIP-712.
# Gunakan address yang berasal dari REWARD_SIGNER_PRIVATE_KEY di backend.
REWARD_SIGNER_ADDRESS=0x_your_backend_signer_address

# RPC URL BSC Testnet (Chain ID 97)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# API Key untuk verifikasi contract (Dapatkan gratis di https://bscscan.com/myapikey)
ETHERSCAN_API_KEY=your_bscscan_api_key_here