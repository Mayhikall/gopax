# Deployment environment variables for BSC Testnet (BNB Testnet)

# Deployer private key. The account must hold tBNB for gas.
PRIVATE_KEY=your_private_key_here

# Backend signer address that authorizes claims through EIP-712.
# Use the address derived from REWARD_SIGNER_PRIVATE_KEY in the backend.
REWARD_SIGNER_ADDRESS=0x_your_backend_signer_address

# Wallet that receives GOPAX from voucher redemptions.
# Optional; deployment uses the deployer address when omitted.
TREASURY_ADDRESS=0x_your_treasury_address

# BSC Testnet RPC URL (chain ID 97)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Contract verification API key (available at https://bscscan.com/myapikey)
ETHERSCAN_API_KEY=your_bscscan_api_key_here